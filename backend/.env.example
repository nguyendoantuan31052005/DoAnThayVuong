# Cấu hình chạy backend trực tiếp trên máy phát triển.
# npm run env:init tự tạo .env và sinh JWT_SECRET riêng, không in khóa ra màn hình.
# Không đưa .env hoặc khóa thật lên GitHub.
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET=
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
HTTP_RATE_LIMIT=120
# Chỉ đặt 1 khi backend nằm sau đúng một reverse proxy đáng tin cậy.
TRUST_PROXY_HOPS=0
# Endpoint POST đầy đủ của FastAPI. Để trống khi chưa có dịch vụ AI thật.
AI_API_URL=
AI_TIMEOUT_MS=10000
# Chỉ điền trong .env nếu FastAPI yêu cầu Bearer token.
AI_API_TOKEN=
