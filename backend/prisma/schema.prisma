generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  organization String @default("")
  passwordHash String
  role String @default("USER")
  blocked Boolean @default(false)
  createdAt DateTime @default(now())
  scans Scan[]
  reports Report[]
  sessions Session[]
}
model Scan {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  url String
  riskScore Float
  riskLevel String
  reasons String
  modelVersion String
  processingMs Int @default(0)
  reports Report[]
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model Report {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  url String
  description String
  reason String @default("OTHER")
  evidenceUrl String @default("")
  scanId String?
  scan Scan? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  scanRiskScore Float?
  scanModelVersion String?
  evidence Evidence?
  status String @default("PENDING")
  adminNote String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}

model Session {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model Evidence {
  reportId String @id
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileName String
  mimeType String
  size Int
  data Bytes
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(uuid())
  actorId String
  action String
  targetId String
  details String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
