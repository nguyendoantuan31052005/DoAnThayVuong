# Cấu hình mẫu cho Docker Compose; chạy npm run env:init -- --docker để tạo .env.
# JWT_SECRET được sinh ngẫu nhiên khi chưa có; không đưa khóa thật lên GitHub.
NODE_ENV=production
DATABASE_URL="file:/data/phishing.db"
JWT_SECRET=
# Cổng trên máy host; ứng dụng trong container luôn dùng cổng 3000.
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
HTTP_RATE_LIMIT=120
# Chỉ đặt 1 khi backend nằm sau đúng một reverse proxy đáng tin cậy.
TRUST_PROXY_HOPS=0
# Dùng tên dịch vụ AI trong cùng Docker network hoặc địa chỉ máy có thể truy cập.
# 127.0.0.1 trong container không phải máy host hay container AI khác.
AI_API_URL=
AI_TIMEOUT_MS=10000
AI_API_TOKEN=
