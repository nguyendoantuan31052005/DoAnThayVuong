{
  "info": {
    "name": "Phishing Backend — NestJS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection tương tác. Cập nhật biến email/password; đăng ký hoặc đăng nhập để tự lưu token. Admin cần adminToken riêng. Kiểm tra URL cần FastAPI thật. Logout/password/delete/block thay đổi trạng thái: chạy có chủ ý, không dùng Run Collection như một test suite độc lập."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "email",
      "value": "demo@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "change-this-demo-password",
      "type": "string"
    },
    {
      "key": "newPassword",
      "value": "another-demo-password",
      "type": "string"
    },
    {
      "key": "url",
      "value": "https://example.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "scanId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reportId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Kiểm tra kết nối database; aiConfigured chỉ cho biết đã cấu hình endpoint",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Đăng ký tài khoản USER và tạo phiên đăng nhập",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"name\": \"Demo User\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const b = pm.response.json(); pm.collectionVariables.set('token', b.accessToken); pm.collectionVariables.set('userId', b.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Đăng nhập bằng email và mật khẩu",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const b = pm.response.json(); pm.collectionVariables.set('token', b.accessToken); pm.collectionVariables.set('userId', b.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Thông tin tài khoản hiện tại",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PATCH /api/auth/me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "Cập nhật tên hiển thị",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tên hiển thị mới\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Scans",
      "item": [
        {
          "name": "POST /api/scans",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/scans",
            "description": "Phân tích URL bằng FastAPI và lưu lịch sử khi thành công",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{url}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('scanId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/scans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/scans?page=1&pageSize=20",
            "description": "Lịch sử kiểm tra của người đăng nhập, phân trang",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/scans/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/scans/{{scanId}}",
            "description": "Chi tiết lần kiểm tra thuộc tài khoản hiện tại",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "DELETE /api/scans/{id}",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/scans/{{scanId}}",
            "description": "Xóa một bản ghi lịch sử của chính mình",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "POST /api/reports",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/reports",
            "description": "Gửi báo cáo website nghi ngờ phishing",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{url}}\",\n  \"description\": \"Website có dấu hiệu giả mạo thương hiệu\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('reportId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reports?page=1&pageSize=20",
            "description": "Báo cáo của chính mình, phân trang",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/reports/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/reports/{{reportId}}",
            "description": "Chi tiết báo cáo của chính mình",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "GET /api/admin/users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/users?page=1&pageSize=20",
            "description": "ADMIN: danh sách người dùng, không trả mật khẩu",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PATCH /api/admin/users/{id}/block",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/users/{{userId}}/block",
            "description": "ADMIN: khóa/mở khóa tài khoản; khóa sẽ thu hồi mọi phiên",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blocked\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET /api/admin/reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/reports?page=1&pageSize=20",
            "description": "ADMIN: tất cả báo cáo, phân trang",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PATCH /api/admin/reports/{id}",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/reports/{{reportId}}",
            "description": "ADMIN: xử lý trạng thái và ghi chú báo cáo",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REVIEWING\",\n  \"adminNote\": \"Đang xác minh báo cáo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET /api/admin/scans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/scans?page=1&pageSize=20",
            "description": "ADMIN: tất cả lịch sử kiểm tra, phân trang",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/admin/stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/stats",
            "description": "ADMIN: tổng người dùng, lượt kiểm tra, lượt nguy hiểm và báo cáo chờ",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "GET /api/admin/ai/status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/ai/status",
            "description": "ADMIN: cấu hình AI và các phiên bản đã trả kết quả; không phải đánh giá độ chính xác",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Session — chạy sau cùng",
      "item": [
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Thu hồi phiên hiện tại; token cũ không dùng lại được",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PATCH /api/auth/password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/password",
            "description": "Đổi mật khẩu và thu hồi toàn bộ phiên; cần đăng nhập lại",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
