  "info": {
    "title": "Phishing Detection Backend",
    "description": "API NestJS + SQLite. JWT 1 giờ; logout thu hồi phiên. API AI bên ngoài, không tự sinh dự đoán khi AI vắng mặt. Các API danh sách trả {items,total,page,pageSize,totalPages}.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "aiConfigured": {
            "type": "boolean",
            "description": "Chỉ báo có endpoint, không xác minh AI đang hoạt động"
          }
        },
        "required": [
          "status",
          "aiConfigured"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "example": "Nguyễn Văn An",
            "minLength": 2,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 72,
            "format": "password",
            "description": "Tối đa 72 byte UTF-8"
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          },
          "blocked": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "blocked",
          "createdAt"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "accessToken": {
            "type": "string",
            "description": "JWT Bearer token"
          },
          "expiresIn": {
            "type": "number",
            "example": 3600
          }
        },
        "required": [
          "user",
          "accessToken",
          "expiresIn"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "PasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password",
            "maxLength": 72
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 10,
            "maxLength": 72
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ScanDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://example.com",
            "maxLength": 2048
          }
        },
        "required": [
          "url"
        ]
      },
      "ScanResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "example": "https://example.com/"
          },
          "riskScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 85
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "SAFE",
              "SUSPICIOUS",
              "DANGEROUS"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modelVersion": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "url",
          "riskScore",
          "riskLevel",
          "reasons",
          "modelVersion",
          "createdAt"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "ReportDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://example.com",
            "maxLength": 2048
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          }
        },
        "required": [
          "url",
          "description"
        ]
      },
      "ReportResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "REVIEWING",
              "CONFIRMED",
              "REJECTED"
            ]
          },
          "adminNote": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "userId",
          "url",
          "description",
          "status",
          "adminNote",
          "createdAt",
          "updatedAt"
        ]
      },
      "BlockDto": {
        "type": "object",
        "properties": {
          "blocked": {
            "type": "boolean"
          }
        },
        "required": [
          "blocked"
        ]
      },
      "ReviewDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "REVIEWING",
              "CONFIRMED",
              "REJECTED"
            ]
          },
          "adminNote": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "status",
          "adminNote"
        ]
      },
      "StatsResponse": {
        "type": "object",
        "properties": {
          "users": {
            "type": "number"
          },
          "scans": {
            "type": "number"
          },
          "dangerousScans": {
            "type": "number",
            "description": "Số lượt nguy hiểm, có thể lặp URL"
          },
          "pendingReports": {
            "type": "number"
          },
          "reviewedReports": {
            "type": "number"
          }
        },
        "required": [
          "users",
          "scans",
          "dangerousScans",
          "pendingReports",
          "reviewedReports"
        ]
      }
    }
  }
}
